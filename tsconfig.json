{
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],

    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",

    "jsx": "react",
    "noImplicitAny": true,
    "strict": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
  },
  "include": ["src", "tsdown.config.ts", "vitest.config.ts"],
}
