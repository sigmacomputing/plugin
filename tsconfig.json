{
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],

    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",

    "jsx": "react-jsx",
    "noImplicitAny": true,
    "strict": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": ["src", "vitest.config.ts", "tsdown.config.ts"]
}
